#include<iostream>
#include<vector>
using namespace std;

class Solution {
public:
    int maxDiff(vector<int>& nums, int left, int right, vector<vector<int>>& memo) {
        if (left == right) {
            return nums[left];
        }
        
        if (memo[left][right] != -1) {
            return memo[left][right];
        }

        int pickLeft = nums[left] - maxDiff(nums, left + 1, right, memo);
        
        int pickRight = nums[right] - maxDiff(nums, left, right - 1, memo);

        return memo[left][right] = max(pickLeft, pickRight);
    }

    bool predictTheWinner(vector<int>& nums) {
        int n = nums.size();
        vector<vector<int>> memo(n, vector<int>(n, -1));
        
        return maxDiff(nums, 0, n - 1, memo) >= 0;
    }
};



class Solution {
public:
    bool stoneGame(vector<int>& piles) {
        int n = piles.size();
       
        vector<vector<int>> dp(n, vector<int>(n, 0));
        
        for (int i = 0; i < n; i++) {
            dp[i][i] = piles[i];
        }
        
        for (int length = 2; length <= n; length++) {
            for (int i = 0; i <= n - length; i++) {
                int j = i + length - 1;
                
               
                int pickLeft = piles[i] - dp[i + 1][j];
                int pickRight = piles[j] - dp[i][j - 1];
                
                dp[i][j] = max(pickLeft, pickRight);
            }
        }
        
       
        return dp[0][n - 1] > 0;
    }
};